{
  "schema": "campus-building-map-index/v1",
  "purpose": "广州应用科技学院（肇庆校区）手绘地图的建筑标注图索引。用户问到某栋楼／某个地点时，用本索引解析出对应图片并直接输出。",
  "source_map": {
    "file": "08b3bb524b29266dfff89c8b3e624b1c.jpg",
    "width": 2559,
    "height": 1279,
    "note": "原始手绘地图，全程只读，未修改"
  },
  "image_dir": ".",
  "image_spec": {
    "size": [
      2559,
      1279
    ],
    "note": "每张图都是完整原图尺寸（未裁剪、未缩放），图上仅用 1 个红色矩形框（线宽 5px）标出该建筑。",
    "format": "PNG",
    "box_color_rgb": [
      230,
      20,
      20
    ],
    "filename_pattern": "{两位编号}_{建筑名}.png"
  },
  "overview_image": {
    "file": "../校园建筑标注框_原图尺寸.png",
    "note": "可选总览图：同一张原图，36 个框全部画出。仅用于整体浏览；回答单栋问题请用 buildings[].image。"
  },
  "how_to_resolve": [
    "1. 归一化用户提问：去掉「怎么走／在哪／位置／在哪里／怎么去／带我去」等词，去掉空格与标点，把「栋／座／楼」视为等价，拉丁字母统一转小写（e栋 = E栋、s5 = S5）。",
    "2. 在 buildings[].aliases 里做精确匹配。",
    "3. 命中恰好 1 个 → 直接输出该建筑的 image 文件。",
    "4. 命中多个（见 alias_conflicts）→ 不要猜。把候选图片全部输出，并说明「你说的 X 可能指这几栋」。",
    "5. 一个都没命中 → 查 not_buildings。若属场地／道路／水系，说明它不是建筑、不在此索引内，必要时给 overview_image；仍无结果则明确回答「地图上没有这个标注」，不要编。"
  ],
