 "spaces": [
  {
   "name": "图书馆主楼",
   "fact": "肇庆校区图书馆坐落北岭山下、丰乐渠畔，2022 年落成；2023 年 9 月 6—9 层投入使用，共九层。",
   "source": "学校官方微信号"
  },
  {
   "name": "1—5 层 阅览区",
   "fact": "总阅览座位近 4000 个；很多座位靠窗，可看青山与丰乐渠；配单人隔间。",
   "source": "学校官方微信号"
  },
  {
   "name": "6—9 层 文化场馆",
   "fact": "设艺术馆、非遗馆、科技馆、教师发展中心；可上天台看晚霞。",
   "source": "学校官方微信号"
  },
  {
   "name": "一楼",
   "fact": "一楼报告厅（大型讲座、宣讲常用场地）。",
   "source": "学校官网新闻"
  },
  {
   "name": "三楼",
   "fact": "三楼小礼堂；301 流通书库、302 特色书展区。",
   "source": "学校官网新闻 + OPAC 馆藏地"
  },
  {
   "name": "七楼",
   "fact": "7 楼非遗馆东侧大厅（如“校长下午茶”活动场地）。",
   "source": "学校官方微信号"
  },
  {
   "name": "九楼",
   "fact": "905 智慧教室；九楼教育新书区、北面临窗高吧台。",
   "source": "学校官网新闻 + OPAC 馆藏地"
  },
  {
   "name": "公共设施",
   "fact": "设党建馆、咖啡吧、报告厅、小礼堂；1—5 楼座位近 4000 个。",
   "source": "学校官方微信号"
  },
  {
   "name": "服务定位",
   "fact": "图书馆定位为校园信息资源中心、自主学习中心、学术交流中心、文化传承中心。",
   "source": "图书馆站 lib.gzasc.edu.cn 站点简介"
  }
 ],
