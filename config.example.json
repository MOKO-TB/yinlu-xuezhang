{
  "providers": [
    {
      "id": "zhipu",
      "name": "智谱 GLM",
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "api_key": "在这里填入你的 API Key",
      "model": "glm-4.6"
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "base_url": "https://api.deepseek.com/v1",
      "api_key": "",
      "model": "deepseek-chat"
    }
  ],
  "active_provider": "zhipu",
  "permission_mode": "confirm",
  "shell": "auto",
  "max_output_chars": 20000,
  "request_timeout_seconds": 300,
  "context_window": 131072,
  "compact_at_ratio": 0.7,
  "vision": false,
  "sandbox": {
    "enabled": true,
    "allow_outside_workspace": false,
    "allow_network": true,
    "timeout_seconds": 60,
    "deny_patterns": []
  },
  "mcp_servers": [
    {
      "id": "filesystem",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "D:/data"],
      "enabled": false,
      "read_only": false,
      "description": "示例:文件系统 MCP 服务器(需 Node.js;enabled 改 true 即启用)"
    },
    {
      "id": "remote-demo",
      "transport": "http",
      "url": "https://example.com/mcp",
      "headers": {
        "Authorization": "${MY_MCP_TOKEN}"
      },
      "enabled": false,
      "read_only": true,
      "description": "示例:只有网址的 MCP 服务器。transport 可写 http(新式 Streamable HTTP)或 sse(老式 HTTP+SSE),留空则是 command 启动的 stdio 服务器。密钥写成 ${环境变量名},发请求时才展开,不会以明文落进 config.json"
    }
  ]
}
