__pycache__/
*.pyc
config.json
sessions/
web-sessions/
web-usage.log
.pytest_cache/
build/
dist/
screen*.png
.automation/

# 本地临时校验目录与抓取原始缓存
_pwtest/
_pwtest_empty/
_tmp_*/
crawled/

# 本地密钥注入文件(不随仓库分发)
config.local.json

# Token 用量记账库(运行时生成,开发态落在仓库根)
token-usage.db
token-usage.db-*

# 模型能力探测缓存(窗口 / 是否支持视觉;运行时生成)
model_caps.json

# 工作区记忆(用户选了哪个文件夹当工作台;运行时装态落在仓库根/exe 旁)
workspaces.json
workspaces.json.tmp

# 浏览器能力运行时产物:Agent 截图与独立实例的 profile(开发态落仓库根)
shots/
browser-profile/
_build_*.log

# 交付材料压缩包(内容与 引入学长/ 目录重复,只留目录)
/引入学长.zip

# GitHub 发版一次性调试脚本(含明文 token,已失效;统一挪到仓库外 tools/ 留档,
# 这里再兜一道,防止谁把它们拷回来误提交 —— gitee 那个远端是公开的)
/check_release.py
/check_upload.py
/create_release.py
/test_api.bat
/test_api.py
/test_github.bat
/test_token.ps1
/upload_asset.py
/upload_zip.py
/upload_output.log


# 知识库成长闭环的运行时日志(应用级数据,不进仓库)
/kb-gaps.jsonl
/kb-candidates.jsonl
/message-feedback.jsonl

# v0.9.17 截止日期提醒的运行时状态(本机待办,不进仓库)
/reminders.json

# ע����� M6 �İ�ȫ��������־(�����º�����,�����ֿ�)
/injection-events.log

# v0.9.18+ 本机运行时状态(课表/天气缓存/公告轮询),跟着使用者走,不进仓库
/schedule.json
/schedule.prev.json
/weather-cache.json
/notice-watch.json

# v0.9.21 候选审核并入的人工知识库(含本机问答,应用级数据,不进仓库)
/kb/reviewed.json
/kb/reviewed.tmp

# v0.9.22 关窗偏好与托盘诊断日志(本机状态)+ 数据目录写探针
/close-pref.json
/monitor-pref.json
/tray.log
/.write-probe.tmp

# v0.9.23 首次运行向导的「不再显示」偏好(本机状态,开发态落在仓库根)
/onboarding.json

# v0.9.25 桌面提醒的开关与类别偏好(本机状态:别人的提醒习惯不该跟着包跑)
/notify-pref.json

# v0.9.26 「今天已经弹过哪几条」的去重账本(本机当日状态,换人换天都得重弹)
/pushed-today.json
# v0.9.42 定时任务账本「每个任务上次何时跑」(v0.9.42 A1)。带去别人机器会把他的
# 第一条周报误判成"这周已经跑过了",所以既不进仓库也不随包外发。
/jobs-state.json

# v0.9.27 本机作息表(自己学校那张节次时刻表,属使用者环境状态,不进仓库)
/period-times.json
# v0.9.28 看门狗运行日志(本机弹过哪些提醒,不进仓库)
/watchdog.log

# v0.9.28 自选城市(weather.py):位置信息,对别人没用,不进仓库
/weather.json

# v0.9.30 导入迁移包前的原件备份(migrate-backup/<时间戳>/,本机副本,绝不进仓库)
/migrate-backup/

# v0.9.32 情绪日记(整个 app 里最私密的一份本机记录;连同原子写的半截文件)
/mood.json
/mood.json.tmp

# 向量检索的本地缓存与「用时下载」的模型权重(都是本机可再生资源,绝不进仓库)
# kb-vectors/ = 条目指纹+向量档(embed.py);models/ = 本地 embedding 权重目录
/kb-vectors/
/models/

# 工具生成的产物(默认工作区 = 程序目录,所以它们会落在仓库根)
# charts/ 是成绩/时长图,images/ 是文字卡片与文生图结果 —— 里面可能有同学自己的
# 姓名与成绩,属于个人数据:不进仓库,也不随分享包外发(build_exe 里同一份清单)。
/charts/
/images/
# uploads/ 是拖进来/粘贴进来的附件原件(📎、拖拽、剪贴板三个入口都只往这里拷)。
# 里面常有同学的课件、成绩单、截图 —— 个人数据:不进仓库,也不随分享包外发。
# 以前它连 .gitignore 都没盖住,谁 `git add -A` 就会把同学的原件一起提上去;
# 看得见与删得掉的入口在 GUI「📁 工作区」弹窗里(桥 uploads_list / uploads_delete)。
/uploads/
